SECRET_KEY=                  # REQUIRED. Random secret; app refuses to start without it.
                             #   python -c "import secrets; print(secrets.token_hex(32))"
APP_USERNAME=owner
APP_PASSWORD_HASH=           # bcrypt hash of your chosen password (see README)
DATABASE_URL=sqlite:///./shop.db
UPLOAD_DIR=./uploads         # where job file attachments are stored
SESSION_HTTPS_ONLY=1         # set to 0 only for local HTTP dev (default 1 = Secure cookie)

# Optional — email reminder digests to the owner (leave blank to disable).
# QuickBooks still owns customer invoicing/collection; these are your heads-up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                       # defaults to SMTP_USER
SMTP_TLS=1
REMINDER_EMAIL=                  # where digests go; defaults to SMTP_FROM/SMTP_USER
